.DS_Store
*.pyc
__pycache__/
*.log
.coverage
# run-next-plan.py runtime artifacts. Name patterns, not exact paths: these files live
# under docs/agents/ in the scaffolding layout and under meta/ in the original one, and a
# raw session transcript reaching this public repo is the worst failure either layout has.
**/implementation-logs/
**/prd.json.lock
**/sdlc-review-findings.md
**/pr-summary.md

# Python build / venv — scoped to demo-gen subproject so we don't
# accidentally hide unrelated build/ or dist/ dirs elsewhere in the repo.
*.pyo
*.pyd
*.egg
demo-gen/.venv/
demo-gen/build/
demo-gen/dist/
demo-gen/*.egg-info/
demo-gen/.mypy_cache/
demo-gen/.pytest_cache/
demo-gen/.ruff_cache/
demo-gen/.coverage
demo-gen/htmlcov/
demo-gen/output/
