# Caddyfile.example
#
# Caddy reverse proxy for Ollama with basic auth and automatic HTTPS.
# Copy to /etc/caddy/Caddyfile and replace all REPLACE_* placeholders.
#
# Generate the bcrypt hash for your password:
#   caddy hash-password --plaintext YOUR_PASSWORD
#
# Then set the hash in this file (never the plaintext).
#
# The env var CADDY_BASIC_AUTH_HASH must be set at startup:
#   CADDY_BASIC_AUTH_HASH="$2a$14$..." caddy run --config Caddyfile
#
# See deploy-notes.md for fly.io and EC2 deployment details.

REPLACE_YOUR_DOMAIN.example.com {
    basicauth /* {
        # Username: ollama
        # Replace the hash below with output of: caddy hash-password
        ollama {env.CADDY_BASIC_AUTH_HASH}
    }

    reverse_proxy localhost:11434

    # Only allow HTTPS — Caddy handles Let's Encrypt automatically.
    # Do NOT add `tls internal` here in production; that would use a
    # self-signed cert that clients cannot verify.
}
