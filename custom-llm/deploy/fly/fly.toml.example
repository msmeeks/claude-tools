# fly.toml.example
#
# Deploy Ollama + Caddy on fly.io.
# Copy to fly.toml and replace REPLACE_YOUR_APP_NAME.
#
# Deploy steps — see README.md for full walkthrough.

app = "REPLACE_YOUR_APP_NAME"
primary_region = "ord"

[build]
  dockerfile = "Dockerfile"

# Persistent volume for downloaded models — survives deploys and restarts.
# Create before first deploy:
#   fly volumes create ollama_models --size 50 --region ord
[mounts]
  source      = "ollama_models"
  destination = "/root/.ollama"

[[services]]
  internal_port = 443
  protocol      = "tcp"

  [[services.ports]]
    port     = 443
    handlers = ["tls", "http"]

  [services.concurrency]
    type       = "requests"
    soft_limit = 10
    hard_limit = 20

# Bump these for larger models. qwen2.5-coder:32b needs ~20GB RAM + GPU.
# Use `fly scale vm a10g` for GPU-accelerated inference.
[vm]
  memory = "8gb"
  cpus   = 4
