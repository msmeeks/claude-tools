#!/usr/bin/env bash
# ec2-user-data.sh.example
#
# EC2 user-data script to install Ollama + Caddy on a fresh Ubuntu 22.04 instance.
# This runs as root at first boot.
#
# Before using:
#   1. Replace REPLACE_YOUR_DOMAIN.example.com with your actual domain.
#   2. Set CADDY_BASIC_AUTH_HASH to: caddy hash-password --plaintext YOUR_PASSWORD
#      Store the *hash* here, never the plaintext. Or better, pull it from
#      AWS Secrets Manager / SSM Parameter Store at boot (see README.md).
#   3. Ensure your EC2 security group allows port 443 from your IP only.
#      Do NOT open port 11434 to the internet.
#
# Security note: EC2 user-data is readable via IMDSv1 at
#   http://169.254.169.254/latest/user-data
# Prefer pulling CADDY_BASIC_AUTH_HASH from SSM rather than embedding it here.
#
# After boot completes (~5 min):
#   ssh ubuntu@<EC2_IP>
#   sudo ollama pull qwen2.5-coder:7b

set -euo pipefail

CADDY_BASIC_AUTH_HASH="${CADDY_BASIC_AUTH_HASH:-REPLACE_CADDY_HASH}"
DOMAIN="${DOMAIN:-REPLACE_YOUR_DOMAIN.example.com}"

# --- Install Ollama ---
curl -fsSL https://ollama.com/install.sh -o /tmp/ollama-install.sh
# Verify checksum before executing — update this hash when upgrading Ollama
# curl -fsSL https://ollama.com/install.sh | sha256sum  to find the current hash
# sha256sum -c - <<< "EXPECTED_SHA256  /tmp/ollama-install.sh"
sh /tmp/ollama-install.sh
rm /tmp/ollama-install.sh
systemctl enable --now ollama

# Bind Ollama to localhost only — Caddy reverse-proxies it, never expose 11434 directly
mkdir -p /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/override.conf <<'EOF'
[Service]
Environment="OLLAMA_HOST=127.0.0.1:11434"
EOF
systemctl daemon-reload
systemctl restart ollama

# --- Install Caddy ---
apt-get install -y --no-install-recommends \
  debian-keyring debian-archive-keyring apt-transport-https curl gpg
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
  | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
  | tee /etc/apt/sources.list.d/caddy-stable.list
apt-get update && apt-get install -y caddy

# --- Write Caddyfile (hash from env, not hardcoded plaintext) ---
cat > /etc/caddy/Caddyfile <<EOF
${DOMAIN} {
    basicauth /* {
        ollama ${CADDY_BASIC_AUTH_HASH}
    }
    reverse_proxy localhost:11434
}
EOF
chmod 640 /etc/caddy/Caddyfile
chown root:caddy /etc/caddy/Caddyfile

systemctl enable --now caddy
